{
  "name": "rmdp-backend",
  "version": "1.0.0",
  "description": "Rwanda Maternal Digital Platform API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed-passwords": "node scripts/ensure-passwords.js",
    "migrate:db": "node scripts/migrate-database.js",
